{
  "name": "electron-vite-boilerplate",
  "version": "2.0.0",
  "main": "dist-electron/main.js",
  "description": "Really simple Electron + Vite boilerplate.",
  "author": "roro <toto@qq.com>",
  "license": "MIT",
  "private": true,
  "keywords": [
    "electron",
    "rollup",
    "vite"
  ],
  "debug": {
    "env": {
      "VITE_DEV_SERVER_URL": "http://127.0.0.1:9999"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && electron-builder",
    "preview": "vite preview"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-electron": "^1.1.2"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  }
}
